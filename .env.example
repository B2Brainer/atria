# Variables del proveedor de IA (CLI de Codex). Copiar a `.env` (ignorado por git) y
# exportarlas al entorno: Atria no carga `.env` por sí sola. La autenticación es la
# de la propia CLI (`codex login`); Atria no lee ni guarda credenciales.

# Binario de codex. Opcional (`codex` del PATH por defecto).
ATRIA_CODEX_BIN=

# Modelo a usar (`--model`). Opcional; vacío = el modelo por defecto de codex.
ATRIA_AI_MODEL=

# Timeout por llamada, en segundos. Opcional (30 por defecto). Sin reintentos.
ATRIA_AI_TIMEOUT=30

# Base de datos de Atria (PostgreSQL). Obligatoria para la persistencia; sin ella,
# `engine_from_env` falla al arrancar. Formato:
# postgresql+psycopg://usuario:contraseña@host:5432/base
ATRIA_DATABASE_URL=

# Máximo de iteraciones por sesión de la API, y valor por defecto si la petición no
# lo indica. Opcional (10 por defecto).
ATRIA_MAX_ITERATIONS=10
