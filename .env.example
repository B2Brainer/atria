# Variables del proveedor de IA (OpenAI). Copiar a `.env` (ignorado por git) y
# exportarlas al entorno: Atria no carga `.env` por sí sola.

# API key de OpenAI. Obligatoria. Nunca se loguea ni se commitea.
OPENAI_API_KEY=

# Modelo a usar. Obligatorio.
ATRIA_AI_MODEL=

# Timeout por llamada, en segundos. Opcional (30 por defecto). Sin reintentos.
ATRIA_AI_TIMEOUT=30
